# ==============================================================================
# AuraStock Enterprise Inventory Management System - Production Environment Configuration
# ==============================================================================

# Core Application Settings
PROJECT_NAME="AuraStock Enterprise Inventory"
VERSION="1.0.0"
ENVIRONMENT="production"
API_V1_STR="/api/v1"

# Production PostgreSQL Database
POSTGRES_DB="inventory_db"
POSTGRES_USER="inventory_user"
POSTGRES_PASSWORD="CHANGE_ME_IN_PRODUCTION_SECURE_PASSWORD_32_CHARS_MIN"
DATABASE_URL="postgresql+asyncpg://inventory_user:${POSTGRES_PASSWORD}@postgres:5432/inventory_db"

# Redis & Background Workers
REDIS_URL="redis://redis:6379/0"

# Cryptographic Keys & JWT Tokens (Generate via: openssl rand -hex 32)
SECRET_KEY="CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Backup & Disaster Recovery
BACKUP_DIR="/backups"
BACKUP_RETENTION_COUNT=7

# Production CORS Allowed Origins
BACKEND_CORS_ORIGINS='["https://inventory.yourcompany.com", "tauri://localhost", "https://tauri.localhost"]'

# Default Enterprise Tenant ID
TENANT_DEFAULT_ID="00000000-0000-0000-0000-000000000001"
