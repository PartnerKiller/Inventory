# ==============================================================================
# AuraStock Enterprise Inventory Management System - Staging Environment Configuration
# ==============================================================================

# Core Application Settings
PROJECT_NAME="AuraStock Enterprise Inventory (Staging)"
VERSION="1.0.0-rc"
ENVIRONMENT="staging"
API_V1_STR="/api/v1"

# Staging Database
POSTGRES_DB="inventory_staging_db"
POSTGRES_USER="inventory_staging_user"
POSTGRES_PASSWORD="staging_secure_password_example"
DATABASE_URL="postgresql+asyncpg://inventory_staging_user:${POSTGRES_PASSWORD}@postgres:5432/inventory_staging_db"

# Redis & Background Workers
REDIS_URL="redis://redis:6379/0"

# Security & JWT Tokens
SECRET_KEY="staging_secret_key_09d25e094faa6ca2556c818166b7a9563b93f709"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Backup & Storage
BACKUP_DIR="/backups"
BACKUP_RETENTION_COUNT=3

# Staging CORS Origins
BACKEND_CORS_ORIGINS='["https://staging.inventory.yourcompany.com", "http://localhost:5173", "tauri://localhost", "https://tauri.localhost"]'

TENANT_DEFAULT_ID="00000000-0000-0000-0000-000000000001"
